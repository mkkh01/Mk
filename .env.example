# =====================================================
#  مثال متغيرات البيئة - انسخ هذا الملف إلى .env محلياً
#  وعلى Render أضف نفس القيم من لوحة Environment
# =====================================================

# --- Supabase (قاعدة البيانات الدائمة) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Redis (الكاش السريع + قفل الدورة) ---
# يمكن أن يكون Upstash Redis المجاني أو Render Redis
REDIS_URL=

# --- بوت التلجرام ---
TELEGRAM_BOT_TOKEN=
# رقم/أرقام الشات المسموح لها (افصل بفاصلة). الإشعارات تذهب لأول واحد.
TELEGRAM_CHAT_ID=
# رابط السيرفر على Render (مثال: https://paper-trading-bot.onrender.com)
# إذا تركته فارغاً يعمل البوت بنظام Polling (مناسب للتجربة المحلية فقط)
WEBHOOK_BASE_URL=
# كلمة سر لحماية الويبهوك والتشغيل اليدوي (اختر أي نص عشوائي طويل)
WEBHOOK_SECRET=

# --- إعدادات الدورة والاستراتيجية (اختيارية - لها قيم افتراضية) ---
CYCLE_SECONDS=60
MONITOR_SECONDS=5
WS_ENABLE=1
TREND_TF=1h
ENTRY_TF=15m
START_BALANCE=10000
RISK_PCT=1.0
LEVERAGE=1
MAX_OPEN_TRADES=6
RR_MIN=2.0
FEE_PCT=0.1
MAX_HOLD_HOURS=48
DATA_SOURCES=okx,gate,kucoin,binance
PORT=10000
