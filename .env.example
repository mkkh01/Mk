# =====================================================
#  مثال متغيرات البيئة - انسخ هذا الملف إلى .env محلياً
#  وعلى Render أضف نفس القيم من لوحة Environment
# =====================================================

# --- قاعدة البيانات (اختر واحداً) ---
# إما رابط Supabase API: https://xxxx.supabase.co (+ المفتاح)
# أو رابط Postgres المباشر: postgresql://... (ينشئ الجداول تلقائياً، والمفتاح غير لازم)
SUPABASE_URL=
SUPABASE_KEY=

# --- Redis (الكاش السريع + قفل الدورة) ---
# يمكن أن يكون Upstash Redis المجاني أو Render Redis
REDIS_URL=

# --- بوت التلجرام ---
TELEGRAM_BOT_TOKEN=
# رقم/أرقام الشات المسموح لها (افصل بفاصلة). الإشعارات تذهب لأول واحد.
TELEGRAM_CHAT_ID=
# رابط السيرفر على Render (مثال: https://paper-trading-bot.onrender.com)
# إذا تركته فارغاً يعمل البوت بنظام Polling (مناسب للتجربة المحلية فقط)
WEBHOOK_BASE_URL=
# كلمة سر لحماية الويبهوك والتشغيل اليدوي (اختر أي نص عشوائي طويل)
WEBHOOK_SECRET=

# --- إعدادات الدورة والاستراتيجية (اختيارية - لها قيم افتراضية) ---
CYCLE_SECONDS=60
MONITOR_SECONDS=5
WS_ENABLE=1
HTF=1h
MTF=15m
LTF=5m
START_BALANCE=10000
RISK_PCT=1.0
LEVERAGE=1
MAX_OPEN_TRADES=3
MIN_SCORE=70
WATCH_SCORE=60
RR_MIN=1.3
ATR_SL_MULT=0.2
SLIPPAGE_BPS=5
COOLDOWN_MINUTES=30
ALLOW_SHORTS=true
FEE_PCT=0.1
MAX_HOLD_HOURS=48
DATA_SOURCES=binance,okx,gate,kucoin
PORT=10000
