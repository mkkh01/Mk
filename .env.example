# CT V4.0 — Environment Variables
# القيم الحقيقية موجودة كـ defaults في config/settings.py
# هذا الملف للـ override فقط عند الحاجة

# TELEGRAM_TOKEN=your_token_here
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ADMIN_ID=1503808643

# Cloudflare Worker proxy لـ Binance REST (لحل HTTP 418 على Render)
# BINANCE_REST_PROXY=https://your-worker.workers.dev
